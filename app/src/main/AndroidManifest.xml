<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:label="تیک‌آف"
        android:icon="@drawable/ic_takeoff_logo"
        android:roundIcon="@drawable/ic_takeoff_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.TakeOffInsights">
        <activity
            android:name=".GlassHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false" android:launchMode="singleTask" android:documentLaunchMode="never" />
        <activity
            android:name=".ShareEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TakeOffInsights.CaptureTrigger">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity android:name=".ViralShareActivity" android:exported="false" android:launchMode="singleTask" android:documentLaunchMode="never" android:label="تیک‌آف — صف یادگیری V4" android:theme="@style/Theme.TakeOffInsights" />
        <activity android:name=".CaptureReviewActivity" android:exported="false" android:theme="@style/Theme.TakeOffInsights" />
        <activity android:name=".ReminderArmActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:theme="@style/Theme.TakeOffInsights.CaptureTrigger" />
        <activity android:name=".CaptureTriggerActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="ai.takeoff.insightscompanion.capture" android:finishOnTaskLaunch="true" android:theme="@style/Theme.TakeOffInsights.CaptureTrigger" />
        <service android:name=".CaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
